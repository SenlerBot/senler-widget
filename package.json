{
  "name": "@senlerio/widget",
  "version": "1.0.0",
  "description": "Typed Senler chat widget SDK with an optional React integration",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js",
      "default": "./dist/global.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SenlerBot/senler-widget.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "check:fast": "sh scripts/run-heavy-task.sh --repo aibot-widget --task widget-sdk-check -- npm run check:internal",
    "check:internal": "tsc --noEmit",
    "build": "sh scripts/run-heavy-task.sh --repo aibot-widget --task widget-sdk-build -- npm run build:internal",
    "build:internal": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && npm run test:internal && node scripts/package-state.mjs --write",
    "test:internal": "node --test test/*.test.mjs",
    "prepack": "node scripts/package-state.mjs --check"
  }
}
